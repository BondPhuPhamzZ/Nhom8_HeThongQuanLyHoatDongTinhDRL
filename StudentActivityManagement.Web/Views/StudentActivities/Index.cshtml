@model ActivityListViewModel
@{
    ViewData["Title"] = Model.Mine ? "Hoạt động của tôi" : "Hoạt động dành cho tôi";
}
<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(Model.Mine ? "" : "active")" asp-action="Index">Sắp diễn ra</a></li>
    <li class="nav-item"><a class="nav-link @(Model.Mine ? "active" : "")" asp-action="Index" asp-route-mine="true">Hoạt động của tôi</a></li>
</ul>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">
            @(Model.Mine
                ? "Hoạt động bạn đã đăng ký, kể cả đã kết thúc: xem kết quả check-in và nộp minh chứng trong hạn."
                : "Chỉ hiển thị hoạt động bạn thuộc đối tượng tham gia, sắp diễn ra hoặc đang diễn ra.")
        </p>
    </div>
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2">
        @if (Model.Mine) { <input type="hidden" name="mine" value="true" /> }
        <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên, đơn vị, địa điểm" />
        <select name="campus" class="form-select w-auto">
            <option value="">Mọi cơ sở</option>
            @foreach (var campus in new[] { "Cơ sở 1", "Cơ sở 2", "Cơ sở 3" })
            {
                <option value="@campus" selected="@(Model.Campus == campus)">@campus</option>
            }
        </select>
        <button class="btn btn-primary" type="submit">Lọc</button>
    </form>
</div>

@if (Model.Page.Items.Count == 0)
{
    <div class="empty-state">@(Model.Mine ? "Bạn chưa đăng ký hoạt động nào." : "Chưa có hoạt động phù hợp với bạn.")</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-3">
        @foreach (var activity in Model.Page.Items)
        {
            <div class="col"><partial name="_ActivityCard" model="activity" /></div>
        }
    </div>
}
<partial name="_Pagination" model="Model" />
