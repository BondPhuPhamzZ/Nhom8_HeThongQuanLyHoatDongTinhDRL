@model ActivityDto
@{
    ViewData["Title"] = Model.ActivityName;
    var registered = Model.MyRegistrationStatus == "Registered";
    // Attended (checked in) still holds a place, but it can no longer be cancelled.
    var attended = Model.MyRegistrationStatus == "Attended";
    var canRegister = (Model.MyRegistrationStatus is null or "Cancelled") && Model.Phase == "RegistrationOpen" && Model.RemainingSlots > 0;
    var canCancel = registered && Model.Phase is "Upcoming" or "RegistrationOpen";
}
<a asp-action="Index" class="btn-back">&larr; Danh sách hoạt động</a>
<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <status-badge value="@Model.Status" label="@Model.PhaseLabel" />
            @if (Model.Eligibility?.ParticipationType is string type)
            {
                <status-badge value="@type" />
            }
            <span class="points-chip">+@Model.TrainingPoints điểm rèn luyện</span>
        </div>
        <div class="mb-3">
            <h1 class="h3 mb-1 text-break">@Model.ActivityName</h1>
            <p class="text-muted mb-0">Đơn vị tổ chức: @Model.OrganizerName</p>
        </div>
        @if (Model.PointsFinalizationBlocked)
        {
            <p class="alert alert-warning small">Đang chờ Phòng QL HSSV mở kỳ đánh giá.</p>
        }
        else if (attended && Model.PointsFinalizedAt == null && Model.Phase != "Cancelled")
        {
            <p class="alert alert-info small">Đã điểm danh, điểm sẽ được chốt lúc <vn-time value="@Model.PointsFinalizeDueAt" />.</p>
        }
        else if (registered && Model.Phase is "Ongoing" or "AttendanceReview")
        {
            <p class="alert alert-info small">Điểm sẽ được chốt lúc <vn-time value="@Model.PointsFinalizeDueAt" />.</p>
        }
        @if (User.IsInRole("Monitor") && (Model.Status is "Published" or "Ongoing"))
        {
            <a class="btn btn-outline-primary btn-sm mb-3" asp-controller="ClassSpace" asp-action="ForwardActivity" asp-route-activityId="@Model.Id">Chuyển thông tin vào lớp</a>
        }
        <p class="pre-line">@Model.Description</p>
        @if (!string.IsNullOrWhiteSpace(Model.Requirements))
        {
            <div class="alert alert-info small pre-line"><strong>Yêu cầu cần chuẩn bị:</strong> @Model.Requirements</div>
        }

        <h2 class="h5 mt-4">Lịch tổ chức</h2>
        <div class="table-responsive card shadow-sm border-0 mb-3">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Buổi</th><th>Bắt đầu</th><th>Kết thúc</th><th>Cơ sở</th><th>Địa điểm</th></tr></thead>
                <tbody>
                    @foreach (var session in Model.Sessions.OrderBy(s => s.SortOrder))
                    {
                        <tr>
                            <td>@session.SessionName</td>
                            <td><vn-time value="@session.StartTime" /></td>
                            <td><vn-time value="@session.EndTime" /></td>
                            <td>@session.Campus</td>
                            <td>@session.Location</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Component.InvokeAsync("StudentCheckIn", new { activityId = Model.Id, registrationStatus = Model.MyRegistrationStatus })
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h2 class="h6">Đăng ký tham gia</h2>
                <dl class="row small mb-3">
                    <dt class="col-6">Mở đăng ký</dt><dd class="col-6"><vn-time value="@Model.RegistrationOpenTime" /></dd>
                    <dt class="col-6">Đóng đăng ký</dt><dd class="col-6"><vn-time value="@Model.RegistrationCloseTime" /></dd>
                    <dt class="col-6">Còn chỗ</dt><dd class="col-6">@Model.RemainingSlots / @Model.MaxParticipants</dd>
                    <dt class="col-6">Trạng thái của bạn</dt>
                    <dd class="col-6">
                        @if (Model.MyRegistrationStatus is string mine) { <status-badge value="@mine" /> } else { <span>Chưa đăng ký</span> }
                    </dd>
                </dl>
                @if (canRegister)
                {
                    <form asp-action="Register" asp-route-id="@Model.Id" method="post">
                        <button class="btn btn-primary w-100" type="submit">
                            @(Model.MyRegistrationStatus == "Cancelled" ? "Đăng ký lại" : "Đăng ký tham gia")
                        </button>
                    </form>
                }
                else if (canCancel)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Hủy đăng ký hoạt động này?');">
                        <button class="btn btn-outline-danger w-100" type="submit">Hủy đăng ký</button>
                    </form>
                }
                else
                {
                    <p class="small text-muted mb-0">
                        @(attended ? "Bạn đã check-in hoạt động này." :
                          registered ? "Đã hết hạn hủy đăng ký." :
                          Model.Status == "Ongoing" ? "Hoạt động đang diễn ra, không nhận đăng ký mới." :
                          Model.Phase != "RegistrationOpen" ? "Ngoài thời gian đăng ký." : "Hoạt động đã đủ số lượng.")
                    </p>
                }
            </div>
        </div>
    </div>
</div>
