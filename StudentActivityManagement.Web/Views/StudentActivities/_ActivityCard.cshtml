@model ActivityDto
@{
    var first = Model.Sessions.OrderBy(s => s.SortOrder).FirstOrDefault();
}
<div class="card h-100 activity-card shadow-sm">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <status-badge value="@Model.Status" />
            <span class="points-chip">+@Model.TrainingPoints điểm</span>
        </div>
        <h2 class="h6 card-title mb-1">@Model.ActivityName</h2>
        <p class="small text-muted mb-2">@Model.OrganizerName</p>
        @if (first != null)
        {
            <p class="small mb-1"><vn-time value="@first.StartTime" /> · @first.Campus</p>
        }
        <p class="small mb-3">
            @Model.Sessions.Count buổi · còn <strong>@Model.RemainingSlots</strong>/@Model.MaxParticipants chỗ
            @if (Model.Eligibility?.ParticipationType is string type)
            {
                <status-badge value="@type" />
            }
        </p>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            @if (Model.MyRegistrationStatus is string mine)
            {
                <status-badge value="@mine" />
            }
            else
            {
                <span class="small text-muted">Đóng đăng ký <vn-time value="@Model.RegistrationCloseTime" /></span>
            }
            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@Model.Id">Chi tiết</a>
        </div>
    </div>
</div>
