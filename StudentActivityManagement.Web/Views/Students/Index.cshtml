@model StudentListViewModel
@{
    ViewData["Title"] = "Quản lý sinh viên";
    var paged = Model.Page;
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Quản lý sinh viên</h1>
        <p class="text-muted mb-0">Hồ sơ sinh viên theo khóa, lớp và cơ sở.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-classId="@Model.ClassId">+ Thêm sinh viên</a>
</div>

<form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3">
    <input name="search" value="@Model.Search" class="form-control w-auto flex-grow-1" placeholder="Tìm theo mã, tên, email" aria-label="Tìm sinh viên" />
    <input name="academicYear" value="@Model.AcademicYear" class="form-control w-auto" style="max-width:8rem" placeholder="Khóa (K22)" aria-label="Khóa" />
    <select name="campus" class="form-select w-auto" aria-label="Cơ sở">
        <option value="">Mọi cơ sở</option>
        @foreach (var campus in new[] { "Cơ sở 1", "Cơ sở 2" })
        {
            <option value="@campus" selected="@(Model.Campus == campus)">@campus</option>
        }
    </select>
    <select name="classId" class="form-select w-auto" aria-label="Lớp">
        <option value="">Mọi lớp</option>
        @foreach (var item in Model.Classes)
        {
            <option value="@item.Id" selected="@(Model.ClassId == item.Id)">@item.ClassCode</option>
        }
    </select>
    <button class="btn btn-outline-primary" type="submit">Lọc</button>
</form>

@if (paged.Items.Count == 0)
{
    <div class="empty-state">Không có sinh viên phù hợp.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0 mb-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Sinh viên</th><th>Email</th><th>Lớp</th><th>Khóa</th><th>Cơ sở</th><th>Vai trò</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var student in paged.Items)
                {
                    <tr>
                        <td><div class="fw-semibold">@student.FullName</div><div class="small text-muted">@student.StudentCode</div></td>
                        <td class="small">@student.Email</td>
                        <td>@student.ClassCode</td>
                        <td>@student.AcademicYear</td>
                        <td>@student.Campus</td>
                        <td>@(student.IsClassMonitor ? "Lớp trưởng" : "Sinh viên")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@student.Id">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@student.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa sinh viên @student.StudentCode? Lịch sử đăng ký của sinh viên cũng bị xóa.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (paged.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination justify-content-center">
                @for (var pageNumber = 1; pageNumber <= paged.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == paged.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@Model.Search"
                           asp-route-campus="@Model.Campus" asp-route-academicYear="@Model.AcademicYear" asp-route-classId="@Model.ClassId">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
    <p class="text-center text-muted small">Tổng cộng @paged.TotalCount sinh viên</p>
}
