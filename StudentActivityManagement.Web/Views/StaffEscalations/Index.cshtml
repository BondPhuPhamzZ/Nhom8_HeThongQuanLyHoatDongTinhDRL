@model PagedResult<ThreadEscalation>
@{
    ViewData["Title"] = "Câu hỏi từ lớp trưởng";
    var status = ViewBag.Status as string;
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Phòng QL HSSV tiếp nhận và phản hồi câu hỏi đã chuyển từ các lớp.</p>
    </div>
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="status" class="form-select w-auto">
            <option value="" selected="@(string.IsNullOrEmpty(status))">Mọi trạng thái</option>
            <option value="Pending" selected="@(status == "Pending")">Chờ trả lời</option>
            <option value="Answered" selected="@(status == "Answered")">Đã trả lời</option>
            <option value="Withdrawn" selected="@(status == "Withdrawn")">Đã rút lại</option>
        </select>
        <button class="btn btn-primary" type="submit">Lọc</button>
    </form>
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">Không có câu hỏi ở trạng thái đã chọn.</div>
}
else
{
    <div class="list-group shadow-sm mb-3">
        @foreach (var item in Model.Items)
        {
            <section class="list-group-item py-3" aria-label="Câu hỏi @item.Id">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                    <span class="fw-semibold">@item.ThreadTitle</span>
                    <span class="small text-muted">@(item.RaisedByName ?? "Lớp trưởng") · <vn-time value="@item.CreatedAt" /></span>
                </div>
                <div class="small text-muted mb-2">Trạng thái: @item.Status · Mã câu hỏi: @item.Id</div>
                <p class="pre-line mb-2">@item.Question</p>
                @if (item.Status == "Pending")
                {
                    <form asp-action="Answer" asp-route-id="@item.Id" method="post" class="mt-2">
                        <input type="hidden" name="status" value="@status" />
                        <input type="hidden" name="page" value="@Model.PageIndex" />
                        <label for="answer-@item.Id" class="form-label">Phản hồi chính thức</label>
                        <textarea id="answer-@item.Id" name="answer" class="form-control mb-2" rows="3" minlength="5" maxlength="4000" required></textarea>
                        <div class="ai-note small mb-2" id="ai-note-@item.Id" hidden></div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Gửi phản hồi</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-ai-draft="@Url.Action("Draft", new { id = item.Id })"
                                    data-ai-target="answer-@item.Id" data-ai-note="ai-note-@item.Id">
                                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                                Gợi ý bằng AI
                            </button>
                        </div>
                    </form>
                }
                else if (item.Answer != null)
                {
                    <div class="alert alert-success py-2 mb-0">
                        <div class="small fw-semibold">@(item.AnsweredByName ?? "Phòng QL HSSV")@if (item.AnsweredAt is DateTime answeredAt) {<text> · </text><vn-time value="@answeredAt" />}</div>
                        <div class="pre-line">@item.Answer</div>
                    </div>
                }
            </section>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang"><ul class="pagination justify-content-center">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-page="@pageNumber">@pageNumber</a>
                </li>
            }
        </ul></nav>
    }
}
@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/staff-ai.js" asp-append-version="true"></script>
}
