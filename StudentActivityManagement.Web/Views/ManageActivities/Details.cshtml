@model ActivityDto
@{
    ViewData["Title"] = Model.ActivityName;
    // Buttons follow the API lifecycle (allowedNextStatuses).
    var buttons = new Dictionary<string, (string Label, string Css)>
    {
        ["Published"] = ("Công bố", "btn-success"),
        ["Draft"] = ("Chuyển về Nháp", "btn-outline-secondary"),
        ["Cancelled"] = ("Hủy hoạt động", "btn-outline-danger")
    };
    var transitions = (Model.AllowedNextStatuses ?? [])
        .Where(buttons.ContainsKey)
        .Select(status => (status, buttons[status].Label, buttons[status].Css))
        .ToArray();
    // The API also refuses drafts that only have cancelled registrations; this hides the obvious cases.
    var canDelete = Model.Status == "Draft" && Model.CurrentParticipantsCount == 0;
}
<a asp-action="Index" class="btn-back">&larr; Danh sách hoạt động</a>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mt-2 mb-3">
    <div>
        <status-badge value="@Model.Status" label="@Model.PhaseLabel" />
        <h1 class="h3 mt-2 mb-1 text-break">@Model.ActivityName</h1>
        <p class="text-muted mb-0">@Model.OrganizerName · tạo ngày <vn-time value="@Model.CreatedAt" format="date" /></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @* Main step of the lifecycle first, then navigation, then reversible/destructive actions. *@
        @if (Model.Phase is "Upcoming" or "RegistrationOpen" or "RegistrationClosed")
        {
            <form asp-action="StartNow" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Bắt đầu hoạt động ngay bây giờ? Hệ thống sẽ đóng đăng ký và dời giờ bắt đầu buổi đầu tiên về thời điểm hiện tại.');">
                <button class="btn btn-primary" type="submit">Bắt đầu ngay</button>
            </form>
        }
        @if (Model.Phase == "Ongoing")
        {
            <form asp-action="EndNow" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Kết thúc hoạt động ngay bây giờ? Các buổi đang diễn ra kết thúc tại thời điểm hiện tại và sinh viên không check-in được nữa.');">
                <button class="btn btn-primary" type="submit">Kết thúc ngay</button>
            </form>
        }
        @if (Model.Phase is "AttendanceReview" or "Finalized")
        {
            <a class="btn btn-primary" asp-controller="Scoring" asp-action="Index" asp-route-id="@Model.Id">@(Model.Phase == "AttendanceReview" ? "Chốt điểm" : "Ghi điểm")</a>
        }
        @foreach (var (status, label, css) in transitions.Where(item => item.status == "Published"))
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Công bố hoạt động này?');">
                <input type="hidden" name="status" value="@status" />
                <button class="btn @css" type="submit">@label</button>
            </form>
        }
        @if (Model.Status != "Draft")
        {
            <a class="btn btn-outline-secondary" asp-controller="Participants" asp-action="Index" asp-route-id="@Model.Id">Người tham gia</a>
        }
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
        }
        @foreach (var (status, label, css) in transitions.Where(item => item.status != "Published"))
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post"
                  onsubmit="@(status == "Cancelled" ? "return confirm('Hủy hoạt động này? Sinh viên đã đăng ký sẽ nhận thông báo và không hoàn tác được.');" : "return confirm('Chuyển hoạt động này về Nháp?');")">
                <input type="hidden" name="status" value="@status" />
                <button class="btn @css" type="submit">@label</button>
            </form>
        }
        @if (canDelete)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xóa hoạt động nháp này? Thao tác không hoàn tác được.');">
                <button class="btn btn-outline-danger" type="submit">Xóa</button>
            </form>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-value">@Model.CurrentParticipantsCount/@Model.MaxParticipants</div><div class="stat-label">Đã đăng ký</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-value">@Model.TrainingPoints</div><div class="stat-label">Điểm rèn luyện</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-value small-value"><vn-time value="@Model.RegistrationOpenTime" /></div><div class="stat-label">Mở đăng ký</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-value small-value"><vn-time value="@Model.RegistrationCloseTime" /></div><div class="stat-label">Đóng đăng ký</div></div></div>
</div>

@if (Model.Phase is not ("Draft" or "Cancelled"))
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value small-value"><vn-time value="@Model.StartTime" /></div><div class="stat-label">Bắt đầu buổi đầu tiên</div></div></div>
        <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value small-value"><vn-time value="@Model.CheckInClosesAt" /></div><div class="stat-label">Hết giờ check-in</div></div></div>
        <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value small-value"><vn-time value="@(Model.PointsFinalizedAt ?? Model.PointsFinalizeDueAt)" /></div><div class="stat-label">@(Model.PointsFinalizedAt.HasValue ? "Đã chốt điểm" : "Dự kiến chốt điểm")</div></div></div>
    </div>
    @if (Model.Phase is "Upcoming" or "RegistrationOpen" or "RegistrationClosed")
    {
        <div class="alert alert-info small mb-4">Hoạt động tự chuyển sang <strong>Đang diễn ra</strong> lúc <vn-time value="@Model.StartTime" />. Bấm <strong>Bắt đầu ngay</strong> nếu muốn bắt đầu sớm (đăng ký sẽ đóng).</div>
    }
    else if (Model.Phase == "Ongoing")
    {
        <div class="alert alert-info small mb-4">Hoạt động tự chuyển sang <strong>Đối chiếu điểm danh</strong> lúc <vn-time value="@Model.CheckInClosesAt" />. Bấm <strong>Kết thúc ngay</strong> để đóng check-in ngay.</div>
    }
    else if (Model.Phase == "AttendanceReview")
    {
        <div class="alert alert-info small mb-4">Đang đối chiếu điểm danh. Điểm tự chốt lúc <vn-time value="@Model.PointsFinalizeDueAt" />, hoặc vào <strong>Chốt điểm</strong> để chốt ngay.</div>
    }
}

<p class="pre-line">@Model.Description</p>
@if (!string.IsNullOrWhiteSpace(Model.Requirements))
{
    <div class="alert alert-light border pre-line"><strong>Yêu cầu cần chuẩn bị:</strong> @Model.Requirements</div>
}

<h2 class="h5 mt-4">Các buổi tổ chức</h2>
<div class="table-responsive card shadow-sm border-0 mb-3">
    <table class="table table-sm align-middle mb-0">
        <thead class="table-light"><tr><th>#</th><th>Buổi</th><th>Bắt đầu</th><th>Kết thúc</th><th>Cơ sở</th><th>Địa điểm</th></tr></thead>
        <tbody>
            @foreach (var session in Model.Sessions.OrderBy(s => s.SortOrder))
            {
                <tr><td>@session.SortOrder</td><td>@session.SessionName</td><td><vn-time value="@session.StartTime" /></td><td><vn-time value="@session.EndTime" /></td><td>@session.Campus</td><td>@session.Location</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Status is "Published" or "Ongoing" or "Completed")
{
    @await Component.InvokeAsync("CheckInCodes", new { activityId = Model.Id })
}

<h2 class="h5 mt-4">Đối tượng tham gia</h2>
@if (Model.AudienceRules.Count == 0)
{
    <p class="text-muted">Mọi sinh viên (@Model.TargetAudience).</p>
}

@if (ViewBag.Settings is ActivitySettingsViewModel settings)
{
    @await Html.PartialAsync("_Settings", settings)
}
else
{
    <ul class="list-unstyled">
        @foreach (var rule in Model.AudienceRules)
        {
            <li class="mb-1">
                <status-badge value="@rule.ParticipationType" />
                @string.Join(" · ", new[] { rule.Campus, rule.AcademicYear is { } year ? $"Khóa {year}" : null, rule.ClassCode is { } code ? $"Lớp {code}" : null }.Where(x => !string.IsNullOrEmpty(x)))
            </li>
        }
    </ul>
}
