@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<h1 class="h3 mb-3">Đặt lại mật khẩu</h1>
<form asp-action="ResetPassword" method="post" class="card p-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Login" class="form-label"></label><input asp-for="Login" class="form-control" autocomplete="username" /><span asp-validation-for="Login" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" maxlength="6" inputmode="numeric" autocomplete="one-time-code" /><span asp-validation-for="Code" class="text-danger"></span></div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
        <div class="form-text">Dài 8–64 ký tự, có chữ cái và chữ số, khác mật khẩu hiện tại và không chứa mã tài khoản.</div>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <div><button class="btn btn-primary" type="submit">Đặt lại mật khẩu</button> <a asp-action="ForgotPassword" class="btn btn-link">Yêu cầu mã mới</a></div>
</form>
