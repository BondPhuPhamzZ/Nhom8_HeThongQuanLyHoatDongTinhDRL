@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Đặt lại mật khẩu</h1>
                <p class="text-muted mb-4">Nhập mã xác nhận đã nhận qua email và mật khẩu mới.</p>
                <form asp-action="ResetPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Login" class="form-label"></label>
                        <input asp-for="Login" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" aria-describedby="password-rules" />
                        <div id="password-rules" class="form-text">Dài 8–64 ký tự, có chữ cái và chữ số, không chứa mã tài khoản.</div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Đặt lại mật khẩu</button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="ForgotPassword" class="small">Yêu cầu mã mới</a>
                    <span class="text-muted small mx-1">·</span>
                    <a asp-action="Login" class="small">Về trang đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>
