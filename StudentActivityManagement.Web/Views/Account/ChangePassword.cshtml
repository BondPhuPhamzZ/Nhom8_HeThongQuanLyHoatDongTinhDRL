@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    var mustChange = User.HasClaim(PasswordChangeRequiredFilter.ClaimType, "1");
}
@if (!mustChange)
{
    <a asp-action="Profile" class="btn-back">&larr; Hồ sơ cá nhân</a>
}
<div class="mt-2 mb-3">
    <h1 class="h3 mb-1">Đổi mật khẩu</h1>
    <p class="text-muted mb-0">Đổi mật khẩu sẽ đăng xuất tài khoản trên các thiết bị khác.</p>
</div>
@if (mustChange)
{
    <div class="alert alert-warning">Bạn cần đổi mật khẩu tạm trước khi dùng các chức năng khác.</div>
}
<div class="row">
    <div class="col-lg-6">
        <form asp-action="ChangePassword" method="post" class="card shadow-sm border-0" novalidate>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small empty-hidden"></div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" aria-describedby="password-rules" />
                    <div id="password-rules" class="form-text">Dài 8–64 ký tự, có chữ cái và chữ số, khác mật khẩu hiện tại và không chứa mã tài khoản.</div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button class="btn btn-primary" type="submit">Đổi mật khẩu</button>
            </div>
        </form>
    </div>
</div>
