@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Quên mật khẩu</h1>
                <p class="text-muted mb-4">Nhập mã tài khoản hoặc email. Mã xác nhận gồm 6 chữ số, có hiệu lực 10 phút và được gửi tới email đã đăng ký.</p>
                <form asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="mb-4">
                        <label asp-for="Login" class="form-label"></label>
                        <input asp-for="Login" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Gửi mã xác nhận</button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Login" class="small">Về trang đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>
