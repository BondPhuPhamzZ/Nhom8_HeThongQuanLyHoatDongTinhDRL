@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<h1 class="h3 mb-3">Quên mật khẩu</h1>
<form asp-action="ForgotPassword" method="post" class="card p-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Login" class="form-label"></label><input asp-for="Login" class="form-control" autocomplete="username" /><span asp-validation-for="Login" class="text-danger"></span></div>
    <p class="small text-muted">Mã xác nhận có hiệu lực trong 10 phút và được gửi đến email đã đăng ký.</p>
    <div><button class="btn btn-primary" type="submit">Gửi mã xác nhận</button> <a asp-action="Login" class="btn btn-link">Về trang đăng nhập</a></div>
</form>
