@model PagedResult<UserNotification>
@{
    ViewData["Title"] = "Thông báo của tôi";
    var unreadOnly = ViewBag.UnreadOnly is true;
    var staff = User.IsInRole("HSSV") || User.IsInRole("SystemAdmin");
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">@(staff ? "Các hoạt động cần xử lý để chốt điểm." : "Thông báo hoạt động mới và nhắc lịch các buổi bạn đã đăng ký.")</p>
    </div>
    <div class="btn-group" role="group" aria-label="Lọc thông báo">
        <a class="btn @(unreadOnly ? "btn-outline-primary" : "btn-primary")" asp-action="Index">Tất cả</a>
        <a class="btn @(unreadOnly ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-unreadOnly="true">Chưa đọc</a>
    </div>
</div>
@if (Model.Items.Count == 0)
{
    <div class="empty-state">Chưa có thông báo trong mục này.</div>
}
else
{
    <div class="list-group card shadow-sm border-0 mb-3">
        @foreach (var item in Model.Items)
        {
            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    @if (item.Kind == "ProfileUpdated")
                    {
                        <a asp-controller="Account" asp-action="Profile" class="fw-semibold">@item.Title</a>
                    }
                    else
                    {
                        <a asp-controller="@(staff ? "Scoring" : "StudentActivities")" asp-action="@(staff ? "Index" : "Details")" asp-route-id="@item.ActivityId" class="fw-semibold">@item.Title</a>
                    }
                    <span class="small text-muted"><vn-time value="@item.CreatedAt" /></span>
                </div>
                <span class="badge text-bg-light border mb-2">@(item.Kind switch { "ClassActivity" => "Hoạt động mới của lớp", "ActivityReminder" => "Nhắc lịch", "FinalizationBlocked" => "Chờ mở kỳ", "PointsFinalized" => "Chốt điểm", _ => "Thông báo" })</span>
                <p class="pre-line text-break mb-2">@item.Body</p>
                @if (item.ReadAt == null)
                {
                    <form asp-action="Read" asp-route-id="@item.Id" method="post">
                        <input type="hidden" name="unreadOnly" value="@unreadOnly.ToString().ToLowerInvariant()" />
                        <input type="hidden" name="page" value="@Model.PageIndex" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Đánh dấu đã đọc</button>
                    </form>
                }
                else
                {
                    <span class="small text-muted">Đã đọc</span>
                }
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang"><ul class="pagination justify-content-center">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-unreadOnly="@unreadOnly">@pageNumber</a>
                </li>
            }
        </ul></nav>
    }
}
