@model UserPanelModel
<div class="user-panel d-flex align-items-center gap-3">
    <div class="text-end lh-sm" title="@Model.FullName · @Model.Code · @Model.RoleLabel">
        <div class="user-panel-name">@Model.FullName</div>
        <div class="user-panel-meta">
            @Model.Code · @Model.RoleLabel@(string.IsNullOrEmpty(Model.ClassCode) ? "" : $" · {Model.ClassCode}")
        </div>
    </div>
    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Đăng xuất</button>
    </form>
</div>
