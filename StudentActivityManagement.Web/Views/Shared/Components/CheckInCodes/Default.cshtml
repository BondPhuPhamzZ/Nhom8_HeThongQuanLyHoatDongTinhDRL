@model ActivityCheckInCodes
@{
    var canIssue = Model.Method == "Code" && Model.ActivityStatus is "Published" or "Ongoing";
}
<h2 class="h5 mt-4">Check-in</h2>
<p class="small text-muted mb-2">
    @if (Model.Method == "Manual")
    {
        <span>Phương thức: điểm danh thủ công.</span>
    }
    else
    {
        <span>Phương thức: sinh viên nhập mã buổi.</span>
    }
    Cửa sổ check-in: mở trước @Model.OpenBeforeMinutes phút, đóng sau buổi @Model.CloseAfterMinutes phút.
    Đổi mã sẽ làm mã cũ hết hiệu lực ngay.
</p>
<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead><tr><th>Buổi</th><th>Cửa sổ check-in</th><th>Mã</th><th class="text-center">Đã check-in</th><th></th></tr></thead>
        <tbody>
            @foreach (var session in Model.Sessions)
            {
                <tr>
                    <td>@session.SessionName</td>
                    <td class="small"><vn-time value="@session.OpensAt" /> – <vn-time value="@session.ClosesAt" /></td>
                    <td>
                        @if (session.Code is string code)
                        {
                            <span class="checkin-code">@code</span>
                        }
                        else
                        {
                            <span class="text-muted small">Chưa phát</span>
                        }
                    </td>
                    <td class="text-center">@session.CheckInCount</td>
                    <td class="text-end">
                        @if (canIssue)
                        {
                            <form asp-controller="ManageActivities" asp-action="GenerateCheckInCode" asp-route-id="@Model.ActivityId" method="post"
                                  onsubmit="return @(session.Code == null ? "true" : "confirm('Đổi mã? Mã hiện tại sẽ hết hiệu lực.')");">
                                <input type="hidden" name="sessionId" value="@session.SessionId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">@(session.Code == null ? "Phát mã" : "Đổi mã")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
