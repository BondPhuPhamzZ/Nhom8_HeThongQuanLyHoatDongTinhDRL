@model ParticipantListViewModel
@{
    var data = Model.Data;
    ViewData["Title"] = $"Người tham gia – {data.ActivityName}";
    var statuses = new[] { ("", "Mọi trạng thái"), ("Registered", "Đã đăng ký"), ("Attended", "Đã tham gia"), ("Absent", "Vắng mặt"), ("Cancelled", "Đã hủy") };
    var returnTo = Context.Request.Path + Context.Request.QueryString;
    var paged = data.Participants;
    var review = data.Phase == "AttendanceReview";
}
<a asp-controller="ManageActivities" asp-action="Details" asp-route-id="@data.ActivityId" class="btn-back">&larr; @data.ActivityName</a>
<div class="mt-2 mb-3">
    <h1 class="h3 mb-1">Người tham gia</h1>
    <status-badge value="@data.ActivityStatus" />
</div>

@if (data.Phase == "Ongoing")
{
    <p class="alert alert-info small">Đang diễn ra: chỉ được thêm điểm danh. Có thể hủy ghi nhận từ <vn-time value="@data.CheckInClosesAt" />.</p>
}
<div class="row g-3 mb-3">
    <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value">@data.Summary.Active</div><div class="stat-label">Đang giữ chỗ</div></div></div>
    <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value">@data.Summary.Attended</div><div class="stat-label">Đã tham gia</div></div></div>
    <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value">@data.Summary.Cancelled</div><div class="stat-label">Đã hủy đăng ký</div></div></div>
</div>

<form asp-action="Index" asp-route-id="@data.ActivityId" method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <input name="search" value="@Model.Search" class="form-control w-auto flex-grow-1" placeholder="Tìm theo mã hoặc tên sinh viên" aria-label="Tìm sinh viên" />
    <select name="status" class="form-select w-auto" aria-label="Trạng thái đăng ký">
        @foreach (var (value, label) in statuses)
        {
            <option value="@value" selected="@(Model.Status == value || (Model.Status == null && value == ""))">@label</option>
        }
    </select>
    <button class="btn btn-outline-primary" type="submit">Lọc</button>
</form>

@if (paged.Items.Count == 0)
{
    <div class="empty-state">Không có sinh viên phù hợp.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0 mb-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sinh viên</th><th>Lớp</th><th>Trạng thái</th>
                    @foreach (var session in data.Sessions)
                    {
                        <th>@session.SessionName<div class="small fw-normal text-muted">@session.CheckInCount lượt</div></th>
                    }
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var participant in paged.Items)
                {
                    <tr>
                        <td><div class="fw-semibold">@participant.FullName</div><div class="small text-muted">@participant.StudentCode</div></td>
                        <td>@participant.ClassCode</td>
                        <td><status-badge value="@participant.RegistrationStatus" /></td>
                        @foreach (var session in data.Sessions)
                        {
                            var checkIn = participant.CheckIns.FirstOrDefault(item => item.SessionId == session.SessionId);
                            <td>
                                @if (checkIn != null)
                                {
                                    <span class="text-success fw-semibold" title="@(checkIn.RecordedByName ?? "Sinh viên tự check-in")">&#10003; <vn-time value="@checkIn.CheckedInAt" /></span>
                                    <div class="small text-muted">@(checkIn.Method == "Manual" ? "Thủ công" : "Mã")</div>
                                    @if (review && participant.RegistrationStatus != "Cancelled")
                                    {
                                        <partial name="_AttendanceAction" model="@(new AttendanceActionViewModel(data.ActivityId, session.SessionId, participant.RegistrationId, true, review, returnTo))" />
                                    }
                                }
                                else if (Model.CanEditAttendance && participant.RegistrationStatus != "Cancelled")
                                {
                                    <partial name="_AttendanceAction" model="@(new AttendanceActionViewModel(data.ActivityId, session.SessionId, participant.RegistrationId, false, review, returnTo))" />
                                }
                                else
                                {
                                    <span class="text-muted">–</span>
                                }
                            </td>
                        }
                        <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@data.ActivityId" asp-route-registrationId="@participant.RegistrationId">Xem</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (paged.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination justify-content-center">
                @for (var pageNumber = 1; pageNumber <= paged.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == paged.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-id="@data.ActivityId" asp-route-page="@pageNumber"
                           asp-route-status="@Model.Status" asp-route-search="@Model.Search">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
    <p class="text-center text-muted small">Tổng cộng @paged.TotalCount sinh viên</p>
}

<partial name="_CheckInLog" model="Model.Log" />
