@model ParticipantDetailViewModel
@{
    var participant = Model.Participant;
    var activity = Model.Activity;
    ViewData["Title"] = $"{participant.FullName} – {activity.ActivityName}";
}
<a asp-action="Index" asp-route-id="@activity.Id" class="small">&larr; Người tham gia: @activity.ActivityName</a>
<div class="d-flex flex-wrap gap-2 align-items-center mt-2">
    <status-badge value="@participant.RegistrationStatus" />
    <span class="text-muted small">Đăng ký lúc <vn-time value="@participant.RegisteredAt" /></span>
</div>
<h1 class="h3 mt-2 mb-1">@participant.FullName</h1>
<p class="text-muted">@participant.StudentCode · @(participant.ClassCode ?? "Chưa có lớp") · @participant.AcademicYear · @participant.Campus</p>

<h2 class="h5 mt-4">Tham gia từng buổi</h2>
<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead><tr><th>Buổi</th><th>Thời gian</th><th>Check-in</th><th></th></tr></thead>
        <tbody>
            @foreach (var session in activity.Sessions.OrderBy(item => item.SortOrder))
            {
                var checkIn = participant.CheckIns.FirstOrDefault(item => item.SessionId == session.Id);
                <tr>
                    <td>@session.SessionName</td>
                    <td class="small"><vn-time value="@session.StartTime" /> – <vn-time value="@session.EndTime" /></td>
                    <td>
                        @if (checkIn != null)
                        {
                            <span class="text-success fw-semibold">&#10003; <vn-time value="@checkIn.CheckedInAt" /></span>
                            <span class="small text-muted">· @(checkIn.Method == "Manual" ? $"Thủ công ({checkIn.RecordedByName})" : "Sinh viên nhập mã")</span>
                        }
                        else
                        {
                            <span class="text-muted">Chưa check-in</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (Model.CanEditAttendance)
                        {
                            <form asp-action="@(checkIn == null ? "RecordCheckIn" : "RemoveCheckIn")" asp-route-id="@activity.Id" method="post" class="m-0"
                                  onsubmit="@(checkIn == null ? "" : "return confirm('Hủy ghi nhận tham gia buổi này?');")">
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <input type="hidden" name="registrationId" value="@participant.RegistrationId" />
                                <button type="submit" class="btn btn-sm @(checkIn == null ? "btn-outline-success" : "btn-outline-danger")">
                                    @(checkIn == null ? "Điểm danh" : "Hủy điểm danh")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
