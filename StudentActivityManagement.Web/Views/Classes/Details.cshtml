@model ClassDetailViewModel
@{
    ViewData["Title"] = $"Lớp {Model.Class.ClassCode}";
}
<a asp-action="Index" class="small">&larr; Danh sách lớp</a>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Class.ClassCode – @Model.Class.ClassName</h1>
        <p class="text-muted mb-0">@Model.Class.Department · Sĩ số @Model.Class.TotalStudents · Lớp trưởng: @(Model.Class.MonitorStudentName ?? "chưa chỉ định")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="Students" asp-action="Create" asp-route-classId="@Model.Class.Id">+ Thêm sinh viên vào lớp</a>
        @if (Model.Class.MonitorStudentId != null)
        {
            <form asp-action="RemoveMonitor" asp-route-id="@Model.Class.Id" method="post" class="m-0"
                  onsubmit="return confirm('Gỡ @Model.Class.MonitorStudentName khỏi chức lớp trưởng? Sinh viên này trở về vai trò sinh viên.');">
                <button type="submit" class="btn btn-outline-secondary">Gỡ lớp trưởng</button>
            </form>
        }
    </div>
</div>

<details class="card shadow-sm border-0 mb-3">
    <summary class="card-body py-2 fw-semibold">Sửa thông tin hoặc xóa lớp</summary>
    <div class="card-body pt-0">
        <form asp-action="Update" asp-route-id="@Model.Class.Id" method="post" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="ClassCode" class="form-label small">Mã lớp</label>
                <input id="ClassCode" name="ClassCode" class="form-control" value="@Model.Class.ClassCode" maxlength="50" required />
            </div>
            <div class="col-md-4">
                <label for="ClassName" class="form-label small">Tên lớp</label>
                <input id="ClassName" name="ClassName" class="form-control" value="@Model.Class.ClassName" maxlength="100" required />
            </div>
            <div class="col-md-3">
                <label for="Department" class="form-label small">Khoa</label>
                <input id="Department" name="Department" class="form-control" value="@Model.Class.Department" maxlength="100" />
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Lưu</button></div>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.Class.Id" method="post" class="mt-3"
              onsubmit="return confirm('Xóa lớp @Model.Class.ClassCode? Chỉ xóa được lớp không còn sinh viên, không là đối tượng của hoạt động và chưa có dữ liệu trao đổi.');">
            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa lớp</button>
            <span class="small text-muted ms-2">Chỉ xóa được lớp trống, chưa dùng cho hoạt động hay trao đổi lớp.</span>
        </form>
    </div>
</details>

@if (Model.Students.Count == 0)
{
    <div class="empty-state">Lớp chưa có sinh viên.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Sinh viên</th><th>Email</th><th>Khóa</th><th>Vai trò</th><th></th></tr></thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    var isMonitor = student.Id == Model.Class.MonitorStudentId;
                    <tr>
                        <td><div class="fw-semibold">@student.FullName</div><div class="small text-muted">@student.StudentCode</div></td>
                        <td class="small">@student.Email</td>
                        <td>@student.AcademicYear</td>
                        <td>
                            @if (isMonitor) { <span class="badge text-bg-primary">Lớp trưởng</span> }
                            else { <span>Sinh viên</span> }
                        </td>
                        <td class="text-end">
                            @if (!isMonitor)
                            {
                                <form asp-action="AssignMonitor" asp-route-id="@Model.Class.Id" method="post" class="m-0"
                                      onsubmit="return confirm('Chỉ định @student.FullName làm lớp trưởng? Lớp trưởng hiện tại (nếu có) trở về vai trò sinh viên.');">
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Chỉ định lớp trưởng</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
