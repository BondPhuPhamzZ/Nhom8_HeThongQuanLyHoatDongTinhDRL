@model ClassListViewModel
@{
    ViewData["Title"] = "Quản lý lớp";
}
<h1 class="h3 mb-1">Quản lý lớp</h1>
<p class="text-muted">Tạo lớp và chỉ định lớp trưởng. Lớp trưởng nhận vai trò Monitor để nhận và chuyển thông báo cho lớp.</p>

<div class="row g-4">
    <div class="col-lg-8">
        @if (Model.Classes.Count == 0)
        {
            <div class="empty-state">Chưa có lớp nào.</div>
        }
        else
        {
            <div class="table-responsive card shadow-sm border-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Lớp</th><th>Khoa</th><th class="text-center">Sĩ số</th><th>Lớp trưởng</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Classes)
                        {
                            <tr>
                                <td><div class="fw-semibold">@item.ClassCode</div><div class="small text-muted">@item.ClassName</div></td>
                                <td>@item.Department</td>
                                <td class="text-center">@item.TotalStudents</td>
                                <td>@(item.MonitorStudentName ?? "Chưa chỉ định")</td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Danh sách lớp</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h2 class="h6">Thêm lớp</h2>
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small empty-hidden"></div>
                    <div class="mb-2">
                        <label asp-for="NewClass.ClassCode" class="form-label small"></label>
                        <input asp-for="NewClass.ClassCode" class="form-control" placeholder="23DTH1" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="NewClass.ClassName" class="form-label small"></label>
                        <input asp-for="NewClass.ClassName" class="form-control" placeholder="Công nghệ thông tin 1 - K23" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewClass.Department" class="form-label small"></label>
                        <input asp-for="NewClass.Department" class="form-control" placeholder="Công nghệ thông tin" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Thêm lớp</button>
                </form>
            </div>
        </div>
    </div>
</div>
