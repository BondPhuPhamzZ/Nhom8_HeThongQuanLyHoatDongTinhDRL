@model ActivityScoring
@{
    ViewData["Title"] = $"Ghi điểm – {Model.ActivityName}";
    string StatusOption(string status) => status switch
    {
        "Approved" => "Đã ghi điểm", "Pending" => "Chờ kiểm tra", "Rejected" => "Từ chối", "Revoked" => "Thu hồi điểm", _ => status
    };
}
<a asp-controller="ManageActivities" asp-action="Details" asp-route-id="@Model.ActivityId" class="btn-back">&larr; @Model.ActivityName</a>
<div class="mt-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Điểm của hoạt động</h1>
        <p class="text-muted mb-0">
            +@Model.TrainingPoints điểm mỗi sinh viên ·
            @if (Model.Period != null) { <span>Kỳ <strong>@Model.Period.Name</strong> <status-badge value="@Model.Period.Status" /></span> }
            else { <span>Chưa có kỳ đánh giá phù hợp</span> }
        </p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value">@Model.Candidates.Count</div><div class="stat-label">Đăng ký còn hiệu lực</div></div></div>
    <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value">@Model.ApprovedCount</div><div class="stat-label">Đã ghi điểm</div></div></div>
    <div class="col-12 col-md-4"><div class="stat-tile"><div class="stat-value">@Model.EligibleCount</div><div class="stat-label">Đã điểm danh, chưa có điểm</div></div></div>
</div>

<div class="alert alert-info">Điểm được ghi tự động ngay khi sinh viên điểm danh (quét QR, nhập mã hoặc điểm danh thủ công). Dùng "Cập nhật quyết định" để đưa về chờ kiểm tra, từ chối hoặc thu hồi điểm, kèm lý do.</div>
@if (Model.EligibleCount > 0 && !Model.CanApprove)
{
    <div class="alert alert-warning">@Model.BlockedReason</div>
}

@if (Model.Candidates.Count == 0)
{
    <div class="empty-state">Hoạt động chưa có đăng ký còn hiệu lực.</div>
}
else
{
    @* The approve form is empty and its fields point at it with form="…", so each row can keep its own transition form. *@
    <div class="table-responsive card mb-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th></th><th>Sinh viên</th><th>Lớp</th><th class="text-center">Check-in</th><th>Điều kiện</th><th>Quyết định điểm</th></tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model.Candidates)
                {
                    <tr>
                        <td>
                            @if (Model.CanApprove && candidate.Eligible)
                            {
                                <input class="form-check-input" type="checkbox" name="registrationIds" value="@candidate.RegistrationId" form="approve-form"
                                       aria-label="Chọn @candidate.FullName" checked />
                            }
                        </td>
                        <td><div class="fw-semibold">@candidate.FullName</div><div class="small text-muted">@candidate.StudentCode</div></td>
                        <td>@candidate.ClassCode</td>
                        <td class="text-center">@candidate.CheckInCount</td>
                        <td class="small">
                            @if (candidate.Eligible) { <span class="text-success">Đủ điều kiện</span> }
                            else { <span class="text-muted">@candidate.IneligibleReason</span> }
                        </td>
                        <td>
                            @if (candidate.PointRecord is PointRecordInfo record)
                            {
                                <status-badge value="@record.Status" /> <span class="fw-semibold">+@record.Points</span>
                                <div class="small text-muted">@(record.DecidedByName ?? "Tự động") · <vn-time value="@record.DecidedAt" /></div>
                                <a class="small" asp-action="History" asp-route-id="@Model.ActivityId" asp-route-pointRecordId="@record.Id"
                                   asp-route-student="@($"{candidate.StudentCode} – {candidate.FullName}")">Lịch sử</a>
                                @if (record.AllowedNextStatuses.Count > 0)
                                {
                                    <form asp-action="Transition" asp-route-id="@Model.ActivityId" method="post" class="mt-2 transition-form">
                                        <input type="hidden" name="pointRecordId" value="@record.Id" />
                                        <select name="status" class="form-select form-select-sm mb-1" aria-label="Trạng thái điểm mới">
                                            @foreach (var nextStatus in record.AllowedNextStatuses)
                                            {
                                                <option value="@nextStatus">@StatusOption(nextStatus)</option>
                                            }
                                        </select>
                                        <input name="reason" class="form-control form-control-sm mb-1" maxlength="500" required placeholder="Lý do bắt buộc" aria-label="Lý do chuyển trạng thái điểm" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Cập nhật quyết định</button>
                                    </form>
                                }
                            }
                            else { <span class="text-muted small">Chưa ghi điểm</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.CanApprove && Model.EligibleCount > 0)
    {
        <form asp-action="Approve" asp-route-id="@Model.ActivityId" method="post" id="approve-form" class="d-flex flex-wrap gap-2 align-items-center">
            <input name="note" class="form-control w-auto flex-grow-1" maxlength="500" placeholder="Ghi chú (không bắt buộc)" aria-label="Ghi chú ghi điểm" />
            <button type="submit" class="btn btn-primary">Ghi điểm cho sinh viên đã chọn</button>
            <button type="submit" name="all" value="true" class="btn btn-outline-primary">Ghi điểm tất cả (@Model.EligibleCount)</button>
        </form>
        <p class="form-text">Dành cho sinh viên đã điểm danh trước khi có kỳ đánh giá mở. Mỗi đăng ký chỉ được ghi điểm một lần.</p>
    }
}
