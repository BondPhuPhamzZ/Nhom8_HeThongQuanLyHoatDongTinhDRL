@model AssistantPageViewModel
@{
    ViewData["Title"] = "Trợ lý điểm rèn luyện";
    var suggestions = new[]
    {
        "Kỳ này mình còn thiếu bao nhiêu điểm?",
        "Có hoạt động nào mình đăng ký được để bù điểm không?",
        "Mình đã đăng ký những hoạt động nào trong kỳ này?",
        "Khi nào mình check-in được cho hoạt động đã đăng ký?"
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Trợ lý điểm rèn luyện</h1>
        <p class="text-muted mb-0">Hỏi về điểm, mục tiêu của kỳ, hoạt động phù hợp, đăng ký và check-in. Trợ lý trả lời từ dữ liệu của chính bạn.</p>
    </div>
    @if (Model.Enabled)
    {
        <a asp-action="Index" asp-route-newChat="true" class="btn btn-primary text-nowrap">Cuộc trò chuyện mới</a>
    }
</div>

@if (Model.Conversations.Items.Count > 0)
{
    <nav class="card shadow-sm border-0 mb-3" aria-label="Cuộc trò chuyện đã lưu">
        <div class="card-body">
            <h2 class="h6">Cuộc trò chuyện đã lưu</h2>
            <div class="list-group list-group-flush">
                @foreach (var item in Model.Conversations.Items)
                {
                    <a asp-action="Index" asp-route-conversationId="@item.Id" asp-route-historyPage="@Model.Conversations.PageIndex"
                       class="list-group-item list-group-item-action @(Model.Current?.Id == item.Id ? "text-bg-primary" : null)"
                       aria-current="@(Model.Current?.Id == item.Id ? "true" : null)">
                        <span class="d-flex flex-wrap justify-content-between gap-2">
                            <span class="text-break">@item.Title</span>
                            <small class="text-nowrap"><vn-time value="@item.LastMessageAt" /></small>
                        </span>
                    </a>
                }
            </div>
            <div class="d-flex gap-3 mt-2">
                @if (Model.Conversations.PageIndex > 1)
                {
                    <a asp-action="Index" asp-route-conversationId="@Model.Current?.Id" asp-route-newChat="@Model.NewChat"
                       asp-route-historyPage="@(Model.Conversations.PageIndex - 1)">Trang trước</a>
                }
                @if (Model.Conversations.PageIndex < Model.Conversations.TotalPages)
                {
                    <a asp-action="Index" asp-route-conversationId="@Model.Current?.Id" asp-route-newChat="@Model.NewChat"
                       asp-route-historyPage="@(Model.Conversations.PageIndex + 1)">Trang sau</a>
                }
            </div>
        </div>
    </nav>
}

@if (!Model.Enabled)
{
    <div class="empty-state">
        @(Model.StatusMessage ?? "Trợ lý AI chưa được bật trên máy chủ.")
        Bạn vẫn xem được điểm và hoạt động gợi ý ở <a asp-controller="StudentPoints" asp-action="Index">Điểm &amp; gợi ý</a>.
    </div>
}
@if (Model.Enabled || Model.Current != null)
{
    <div class="alert alert-info small" role="note">
        <strong>Lưu ý:</strong> câu hỏi được gửi tới Google Gemini (bản miễn phí) và Google có thể dùng nội dung để cải thiện dịch vụ.
        Đừng nhập họ tên, mã sinh viên, số điện thoại hay thông tin cá nhân khác. Trợ lý có thể nhầm, hãy kiểm tra lại ở trang chi tiết hoạt động.
    </div>

    <section class="card shadow-sm border-0 assistant" data-chat-url="@Url.Action("Chat")" data-conversation-id="@Model.Current?.Id" aria-label="Trò chuyện với trợ lý">
        @Html.AntiForgeryToken()
        <div class="assistant-log" id="assistant-log" aria-live="polite">
            @if (Model.Current == null)
            {
                <div class="assistant-msg assistant-msg-bot">
                    <div class="assistant-bubble">Chào bạn! Mình có thể tra điểm rèn luyện, số điểm còn thiếu, gợi ý hoạt động phù hợp và lịch check-in của bạn.</div>
                </div>
            }
            @foreach (var message in Model.Current?.Messages ?? [])
            {
                <div class="assistant-msg @(message.Role == "user" ? "assistant-msg-user" : "assistant-msg-bot")">
                    <div class="assistant-bubble">@message.Content</div>
                    @if (message.Status == "Failed")
                    {
                        <small class="text-muted">Chưa nhận được câu trả lời.</small>
                    }
                    @if (message.Activities.Count > 0)
                    {
                        <div class="assistant-activities">
                            @foreach (var activity in message.Activities)
                            {
                                <a asp-controller="StudentActivities" asp-action="Details" asp-route-id="@activity.Id" class="card assistant-activity">
                                    <span class="d-flex justify-content-between gap-2">
                                        <strong>@activity.ActivityName</strong>
                                        <span class="badge text-bg-primary">@activity.TrainingPoints điểm</span>
                                    </span>
                                    <small>@activity.Campus @if (activity.StartTime.HasValue) { <vn-time value="@activity.StartTime.Value" /> }</small>
                                </a>
                            }
                        </div>
                    }
                    @if (message.ToolsUsed.Count > 0)
                    {
                        <div class="assistant-tools small text-muted">Đã tra cứu: @string.Join(", ", message.ToolsUsed.Select(StudentActivityManagement.Web.Controllers.AssistantController.ToolLabel))</div>
                    }
                </div>
            }
        </div>
        @if (Model.Enabled)
        {
        <div class="assistant-suggestions" id="assistant-suggestions">
            @foreach (var question in suggestions)
            {
                <button type="button" class="btn btn-outline-primary btn-sm" data-question="@question">@question</button>
            }
        </div>
        <form class="assistant-form" id="assistant-form">
            <label for="assistant-input" class="visually-hidden">Câu hỏi</label>
            <textarea id="assistant-input" class="form-control" rows="2" maxlength="1000" placeholder="Nhập câu hỏi về điểm rèn luyện… (Enter để gửi, Shift+Enter để xuống dòng)"></textarea>
            <button type="submit" class="btn btn-primary" id="assistant-send">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg> Gửi
            </button>
        </form>
        <p class="assistant-model small text-muted mb-0">
            Mô hình: @Model.Model · Còn <span id="assistant-remaining">@Model.RemainingToday</span>/@Model.DailyQuestionLimit câu hỏi hôm nay
        </p>
        <p class="small text-warning mb-0" id="assistant-token-warning"
           hidden="@(Model.DailyTokenLimit <= 0 || Model.TokensUsedToday * 10L <= Model.DailyTokenLimit * 9L)">
            Sắp hết hạn mức hôm nay.
        </p>
        }
    </section>
}

@section Scripts {
    @if (Model.Enabled)
    {
        <script src="~/js/assistant.js" asp-append-version="true"></script>
    }
}
