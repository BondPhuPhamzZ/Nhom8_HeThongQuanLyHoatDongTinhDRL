@model ClassThreadDetail
@{
    ViewData["Title"] = Model.Title;
}
<a asp-action="Index" class="small">&larr; Trao đổi lớp</a>
<div class="card shadow-sm border-0 mt-2 mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            @if (Model.IsPinned) { <span class="badge text-bg-warning">Ghim</span> }
            <status-badge value="@Model.Kind" />
            @if (Model.Status != "Open") { <status-badge value="@Model.Status" /> }
            <partial name="_EscalationBadge" model="Model.EscalationStatus" />
        </div>
        <h1 class="h4">@Model.Title</h1>
        <p class="small text-muted">
            @Model.Author.FullName (@Model.Author.StudentCode)@(Model.Author.IsMonitor ? " · lớp trưởng" : "") · <vn-time value="@Model.CreatedAt" />
        </p>
        <p class="pre-line mb-0">@Model.Body</p>
        @if (Model.CanPin)
        {
            <form asp-action="Pin" asp-route-id="@Model.Id" method="post" class="mt-3">
                <input type="hidden" name="isPinned" value="@(!Model.IsPinned).ToString().ToLowerInvariant()" />
                <button type="submit" class="btn btn-sm btn-outline-warning">@(Model.IsPinned ? "Bỏ ghim" : "Ghim lên đầu lớp")</button>
            </form>
        }
        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Xóa chủ đề này?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa chủ đề</button>
            </form>
        }
    </div>
</div>

@if (Model.Escalation is { } escalation)
{
    <div class="card mb-4 @(escalation.Answer != null ? "border-success" : "")">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h2 class="h6 mb-0">Câu hỏi đã chuyển lên Phòng QL HSSV</h2>
                <partial name="_EscalationBadge" model="escalation.Status" />
            </div>
            <p class="small text-muted pre-line mb-2">@escalation.Question</p>
            @if (escalation.Answer != null)
            {
                <div class="alert alert-success py-2 mb-2">
                    <div class="small fw-semibold">
                        Phản hồi của @(escalation.AnsweredByName ?? "Phòng QL HSSV")
                        @if (escalation.AnsweredAt.HasValue) { <span>· <vn-time value="@escalation.AnsweredAt.Value" /></span> }
                    </div>
                    <div class="pre-line">@escalation.Answer</div>
                </div>
                @if (escalation.CanRelay)
                {
                    <form asp-action="Relay" asp-route-escalationId="@escalation.Id" asp-route-threadId="@Model.Id" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-primary">Chuyển phản hồi vào lớp</button>
                        <span class="small text-muted ms-2">Cả lớp sẽ thấy phản hồi này là câu trả lời chính thức.</span>
                    </form>
                }
                else if (escalation.RelayedAt.HasValue)
                {
                    <p class="small text-success mb-0">Đã chuyển vào lớp · <vn-time value="@escalation.RelayedAt.Value" /></p>
                }
            }
            else if (escalation.Status == "Pending")
            {
                <p class="small text-muted mb-0">Đang chờ Phòng QL HSSV trả lời. Bạn sẽ nhận thông báo khi có phản hồi.</p>
            }
        </div>
    </div>
}

@if (Model.CanEscalate)
{
    <details class="card shadow-sm border-0 mb-4">
        <summary class="card-body py-2 fw-semibold">Chuyển lên Phòng QL HSSV</summary>
        <form asp-action="Escalate" asp-route-id="@Model.Id" method="post" class="card-body pt-0">
            <label for="question" class="form-label small">Nội dung cần phòng xác nhận (chỉ lớp trưởng thấy và theo dõi phản hồi)</label>
            <textarea id="question" name="question" class="form-control mb-2" rows="3" minlength="5" maxlength="2000" required>@Model.Title</textarea>
            <button type="submit" class="btn btn-warning">Chuyển lên</button>
            <a asp-action="Escalations" class="btn btn-link">Các câu hỏi đã chuyển</a>
        </form>
    </details>
}

<h2 class="h5">@Model.ReplyCount trả lời</h2>
@if (Model.Replies.Count == 0)
{
    <div class="empty-state mb-3">Chưa có ai trả lời.</div>
}
else
{
    <div class="list-group shadow-sm mb-3">
        @foreach (var reply in Model.Replies)
        {
            <div class="list-group-item py-3 @(reply.IsAnswer ? "border-success" : "")">
                <div class="d-flex flex-wrap justify-content-between gap-2 small text-muted mb-1">
                    <span>
                        <span class="fw-semibold text-body">@reply.Author.FullName</span>
                        @if (reply.Author.IsMonitor) { <span class="badge text-bg-primary">Lớp trưởng</span> }
                        @if (reply.IsAnswer) { <span class="badge text-bg-success">Câu trả lời được chọn</span> }
                    </span>
                    <vn-time value="@reply.CreatedAt" />
                </div>
                <p class="pre-line mb-0">@reply.Body</p>
                @if (reply.CanMarkAnswer)
                {
                    <form asp-action="MarkAnswer" asp-route-id="@Model.Id" asp-route-replyId="@reply.Id" method="post" class="mt-2">
                        <button type="submit" class="btn btn-sm btn-outline-success">Chọn làm câu trả lời chính thức</button>
                    </form>
                }
                @if (reply.CanDelete)
                {
                    <form asp-action="DeleteReply" asp-route-id="@Model.Id" asp-route-replyId="@reply.Id" method="post" class="mt-2" onsubmit="return confirm('Xóa trả lời này?');">
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0">Xóa</button>
                    </form>
                }
            </div>
        }
    </div>
}

@if (Model.Status == "Closed")
{
    <div class="alert alert-secondary">Chủ đề đã đóng, không nhận thêm trả lời.</div>
}
else
{
    <form asp-action="Reply" asp-route-id="@Model.Id" method="post" class="card shadow-sm border-0">
        <div class="card-body">
            <label for="body" class="form-label small">Trả lời của bạn</label>
            <textarea id="body" name="body" class="form-control mb-2" rows="3" maxlength="4000" required></textarea>
            <button type="submit" class="btn btn-primary">Gửi trả lời</button>
        </div>
    </form>
}
