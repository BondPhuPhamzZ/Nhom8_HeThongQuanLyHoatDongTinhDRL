{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=student_activity.db"
  },
  "JwtSettings": {
    "Issuer": "StudentActivityManagement.API",
    "Audience": "StudentActivityClient",
    "ExpiryMinutes": "1440"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "EvidenceStorage": {
    "RootPath": "App_Data/evidence",
    "MaxFileSizeBytes": 5242880,
    "MaxEvidencesPerRegistration": 5,
    "SubmissionWindowDays": 7
  },
  "Gemini": {
    "Model": "gemini-3.5-flash-lite",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 2048,
    "SafetyThreshold": "BLOCK_MEDIUM_AND_ABOVE"
  },
  "Assistant": {
    "Enabled": true,
    "MaxToolRounds": 4,
    "MaxMessages": 12,
    "MaxMessageLength": 1000,
    "RequestsPerMinute": 6,
    "DailyQuestionLimit": 40
  }
}
